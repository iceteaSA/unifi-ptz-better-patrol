{
  "release-type": "simple",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "refactor",
      "section": "Code Refactoring"
    },
    {
      "type": "test",
      "section": "Tests"
    },
    {
      "type": "ci",
      "section": "Continuous Integration"
    },
    {
      "type": "chore",
      "section": "Miscellaneous Chores"
    }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "version-file": "VERSION",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
