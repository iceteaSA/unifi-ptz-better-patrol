{
  "nvr_address": "https://127.0.0.1",
  "username": "api-user",
  "password": "changeme",
  "reauth_seconds": 3600,
  "auto_discover": true,
  "rediscovery_interval_seconds": 600,
  "log_level": "info",
  "_note_status_webhook": "The URL is a secret. Keep its webhook id private. An empty URL disables status posts.",
  "status_webhook_url": "",

  "defaults": {
    "dwell_seconds": 30,
    "motion_hold_seconds": 15,
    "max_tracking_wait": 300,
    "manual_control_hold_seconds": 120,
    "_note_ptz_settle": "At startup, settle uses min(ptz_settle_seconds, max(1, dwell_seconds/2)). After each goto with HTTP 200 or 204, recompute settle from that slot's preset_dwell_seconds or dwell_seconds. Poll uses slot_dwell/3 with minimum 2 and maximum 5 seconds. Home-between-cycles uses the camera dwell, settle, and poll values.",
    "ptz_settle_seconds": 10,
    "home_on_shutdown": false,
    "home_between_cycles": false,
    "schedule": null,
    "dynamic_auto_tracking": false,
    "_note_auto_tracking": "Types must be an array. Person is always a valid type. Vehicle is available only on compatible cameras. Invalid or empty types use person. Zoom null keeps the camera setting. True or false changes zoom only when auto-tracking is enabled.",
    "auto_tracking_object_types": ["person"],
    "auto_tracking_with_zoom": null,
    "_note_status_heartbeat": "Seconds between status posts. Use an integer with a minimum of 30, or 0 for state changes only.",
    "status_heartbeat_seconds": 300
  },

  "camera_overrides": {
    "EXAMPLE_CAMERA_ID_HERE": {
      "enabled": true,
      "dwell_seconds": 45,
      "motion_hold_seconds": 20,
      "max_tracking_wait": 180,
      "manual_control_hold_seconds": 60,
      "preset_slots": [0, 1, 3],
      "schedule": {
        "start": "22:00",
        "end": "06:00",
        "days": ["mon", "tue", "wed", "thu", "fri"],
        "home_on_pause": true
      },
      "dynamic_auto_tracking": true
    },
    "EXAMPLE_CAMERA_ID_2_HERE": {
      "enabled": true,
      "preset_slots": [0, 4, 2],
      "_note_path_mode": "pingpong uses the inner slots in the opposite order after the last slot. The path uses each endpoint one time. The default is loop.",
      "path_mode": "pingpong",
      "_note_preset_dwell": "Dwell seconds for each slot. Other slots and home use dwell_seconds. Settle and poll intervals use each slot dwell.",
      "preset_dwell_seconds": {"4": 45, "2": 15},
      "schedule": {
        "start": "08:00",
        "end": "20:00",
        "days": ["mon", "tue", "wed", "thu", "fri"],
        "constrain_start_minute": 15,
        "_note_constrain_minutes": "The start minute is inclusive and the end minute is exclusive; the window wraps the hour when start > end and requires schedule.start and schedule.end.",
        "constrain_end_minute": 45,
        "home_on_pause": true
      },
      "dynamic_auto_tracking": false
    }
  }
}
